# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:1.7b
# think=false (recomendado en hardware modesto): evita el razonamiento oculto de qwen3,
# que duplica/tiplica el tiempo por respuesta. LLM_THINK=true solo si hace falta razonar.
LLM_THINK=false
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Qdrant
#   local  -> Qdrant embebido en el proceso (por defecto, sin servidor)
#   remote -> servidor Qdrant independiente en QDRANT_URL
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=data/qdrant_local
COLLECTION_NAME=narrative_chunks

# Datos
BOOKS_DIR=data/books

# Ingestion / retrieval
# CHUNK_TOKENS=700 y CHUNK_OVERLAP=100 son los valores recomendados por los
# experimentos de Fase 1.5 (recall@8 0.750 vs 0.719 con 500/50). Si cambias el
# chunking, vuelve a ingerir: python scripts/ingest.py data/books/<tu-novela>.docx
CHUNK_TOKENS=700
CHUNK_OVERLAP=100
TOP_K=8
EMBEDDING_BATCH_SIZE=32
LLM_TEMPERATURE=0.2

# Estrategia de retrieval (Fase 1.5, experimental)
#   RETRIEVAL_QUERY_EXPANSION: off | heuristic | llm
#   RETRIEVAL_RERANK: none | mmr
# Por defecto off/none: fue la configuracion que mejor recall dio en los
# experimentos. multi-query/MMR se pueden activar por libro con estas variables,
# pero NO mejoraron recall@8 y triplican el tiempo por consulta (~6.5s vs ~2.6s);
# la expansion LLM cuesta ~4-15s adicionales por pregunta.
RETRIEVAL_QUERY_EXPANSION=off
RETRIEVAL_RERANK=none
RETRIEVAL_MAX_QUERIES=4
RETRIEVAL_CANDIDATES_PER_QUERY=8
RETRIEVAL_DIVERSITY_LAMBDA=0.7
RETRIEVAL_CHAPTER_PENALTY=0.5

# Retrieval hybrid (EXPERIMENTAL, DESCARTADO en Fase 2C): fusion Qdrant + memoria
# narrativa. No aporto mejoras sobre la memoria sola y duplico el tiempo de retrieval
# (veredicto completo en data/eval_answers/hybrid_report.md). OFF por defecto; se
# conserva SOLO como referencia para regenerar el informe del experimento.
# La memoria SOLO localiza chunks (source_chunks/chunk_refs); el texto final se
# resuelve siempre en Qdrant.
#   RETRIEVAL_HYBRID: off (defecto) | narrative
# RETRIEVAL_HYBRID=off
# HYBRID_NARRATIVE_TOP=8
# HYBRID_CHUNKS_PER_CHAPTER=1
# HYBRID_FUSION=rrf
# HYBRID_WEIGHT_BASELINE=0.4
# HYBRID_WEIGHT_NARRATIVE=0.6
# HYBRID_MEMORY_PATH=data/narrative_memory.json
